---
import { Image } from "astro:assets";
import Card from "./Card.astro";

interface Props {
  url: string;
  avatarUrl: string;
  name: string;
  member?: boolean;
}

const { name, avatarUrl, url, member = false } = Astro.props;
---

<a href={url} target="_blank" class="group flex w-full justify-center">
  <Card>
    <div class="flex flex-col items-center gap-6">
      <div
        class="ease relative h-18 w-18 transition-transform duration-300 group-hover:scale-[1.06]"
      >
        {member ? (
          <div
            class="ease absolute -inset-[10px] [animation:spin_50s_linear_infinite] rounded-full border border-dashed border-gray6 transition-[opacity,inset] duration-300 group-hover:-inset-[13px] group-hover:border-bright-black motion-reduce:animate-none"
          />
        ) : null}
        <div
          class="ease absolute -inset-1 rounded-full border border-white transition-[border-color,inset] duration-300 group-hover:-inset-[5px] group-hover:border-bright-white"
        ></div>
        <Image
          width="100"
          height="100"
          class="block h-18 w-18 rounded-full bg-black object-cover"
          src={avatarUrl}
          alt={name}
        />
      </div>
      <div
        class="ease text-center text-sm tracking-[2px] break-words text-white transition-[letter-spacing] duration-300 group-hover:tracking-[3px] group-hover:text-bright-white"
      >
        {name}
      </div>
    </div>
  </Card>
</a>

<style>
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
