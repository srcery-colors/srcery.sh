---
interface Props {
  title: string;
  color?: string;
  text_size?: string;
  subtitle?: boolean;
  id?: string;
}

const {
  title,
  color = "color-bright-white",
  text_size = "text-base",
  subtitle = false,
  id,
} = Astro.props;

const anchorId = id ?? title.toLowerCase().replace(/\s+/g, "-");
---

<div class="flex flex-wrap items-center gap-2" id={anchorId}>
  <a
    href={`#${anchorId}`}
    class="group flex items-center gap-2 font-bold uppercase no-underline"
  >
    <span
      class:list={[
        "-ml-4 text-white opacity-0 transition-opacity group-hover:opacity-100",
        text_size,
      ]}
      >#</span
    >
    <span class:list={[text_size, color]}>{title}</span>
  </a>
  {!subtitle ? <div class="section-line h-[1px] flex-1" /> : null}
  <slot />
</div>

<style>
  .section-line {
    background: linear-gradient(90deg, var(--color-bright-black), transparent);
  }
</style>
