---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  class="inline-block text-[11px] tracking-[2px] uppercase no-underline py-1.5 px-4 border text-center transition-[color,border-color,background-color] duration-200 relative text-bright-white border-bright-black hover:border-white hover:text-bright-white hover:bg-gray1"
>
  <slot />
</a>
