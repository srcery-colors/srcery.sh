---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  class="relative inline-block border border-bright-black px-4 py-1.5 text-center text-[11px] tracking-[2px] text-bright-white uppercase no-underline transition-[color,border-color,background-color] duration-200 hover:border-white hover:bg-gray1 hover:text-bright-white"
>
  <slot />
</a>
